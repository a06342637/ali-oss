#!/usr/bin/env bash
set -Eeuo pipefail

root="${FAKE_OSS_ROOT:?FAKE_OSS_ROOT is required}"
command_name="${1:-}"
shift || true

uri_to_path() {
  local uri="$1"
  [[ "$uri" == oss://* ]] || return 1
  printf '%s/%s' "$root" "${uri#oss://}"
}

case "$command_name" in
  version)
    printf '2.3.0\n'
    ;;
  cp)
    source_file="$1"
    destination="$2"
    shift 2
    sha=""
    while [[ "$#" -gt 0 ]]; do
      case "$1" in
        --metadata)
          sha="${2#dujiao-sha256=}"
          shift 2
          ;;
        *) shift ;;
      esac
    done
    destination_path="$(uri_to_path "$destination")"
    mkdir -p "$(dirname "$destination_path")"
    cp -- "$source_file" "$destination_path"
    printf '%s\n' "$sha" > "$destination_path.dujiao-sha256"
    ;;
  stat)
    object_path="$(uri_to_path "$1")"
    [[ -f "$object_path" ]] || exit 3
    size="$(stat -c %s "$object_path")"
    sha="$(< "$object_path.dujiao-sha256")"
    printf '{\n'
    printf '  "Content-Length": "%s",\n' "$size"
    printf '  "X-Oss-Meta-Dujiao-Sha256": "%s"\n' "$sha"
    printf '}\n'
    ;;
  rm)
    object_path="$(uri_to_path "$1")"
    rm -f -- "$object_path" "$object_path.dujiao-sha256"
    ;;
  ls)
    uri="$1"
    directory="$(uri_to_path "$uri")"
    count=0
    if [[ -d "$directory" ]]; then
      while IFS= read -r name; do
        printf '%s%s\n' "$uri" "$name"
        count="$((count + 1))"
      done < <(
        find "$directory" -mindepth 1 -maxdepth 1 -type f \
          -name 'dujiao-next-????????-??????.tar' -printf '%f\n' | sort
      )
    fi
    printf 'Object Number is: %s\n' "$count"
    ;;
  *)
    printf 'fake ossutil: unsupported command %s\n' "$command_name" >&2
    exit 2
    ;;
esac
